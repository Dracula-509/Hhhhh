<%- include('partials/header', { title: 'Formulaire anime' }) %>
<h1><%= anime ? 'Modifier' : 'Nouvel' %> anime</h1>

<form method="POST" enctype="multipart/form-data"
      action="<%= anime ? '/admin/anime/' + anime.id : '/admin/anime' %>" class="auth-form wide">
  <input name="title" placeholder="Titre" value="<%= anime ? anime.title : '' %>" required>
  <textarea name="synopsis" placeholder="Synopsis" rows="5"><%= anime ? anime.synopsis : '' %></textarea>
  <input name="genres" placeholder="Genres séparés par des virgules (Action, Shonen, Aventure)" value="<%= anime ? anime.genres : '' %>">
  <input type="number" name="year" placeholder="Année" value="<%= anime ? anime.year : '' %>">
  <select name="status">
    <% ['En cours', 'Terminé'].forEach(s => { %>
      <option <%= anime && anime.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <label class="muted small">Image de couverture (jpg, png, webp)</label>
  <input type="file" name="cover" accept="image/*">
  <button class="btn">Enregistrer</button>
</form>
<%- include('partials/footer') %>
