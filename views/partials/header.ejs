<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Otaku FAMILY</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="nav">
  <a href="/" class="logo">
    ⛩️ Otaku FAMILY
    <small class="powered">POWERED BY Mr Dracula Dev</small>
  </a>
  <div class="nav-links">
    <% if (user) { %>
      <% if (['admin','owner'].includes(user.role)) { %><a href="/admin">Admin</a><% } %>
      <span class="muted"><%= user.username %></span>
      <a href="/logout">Déconnexion</a>
    <% } else { %>
      <a href="/login">Connexion</a>
      <a href="/register" class="btn">Inscription</a>
    <% } %>
  </div>
</nav>
<main class="container">
