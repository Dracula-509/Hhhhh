<%- include('partials/header', { title: 'Épisodes' }) %>
<a href="/admin" class="muted">← Retour</a>
<h1>Épisodes : <%= anime.title %></h1>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" enctype="multipart/form-data" action="/admin/anime/<%= anime.id %>/episodes" class="auth-form wide">
  <input type="number" name="number" placeholder="Numéro de l'épisode" required>
  <input name="title" placeholder="Titre (optionnel)">
  <label class="muted small">Vidéo au format MP4 (H.264 + AAC), 2 Go max, pour la compatibilité iPhone</label>
  <input type="file" name="video" accept="video/mp4" required>
  <button class="btn">Uploader l'épisode</button>
</form>

<table class="table">
  <tr><th>#</th><th>Titre</th><th></th></tr>
  <% episodes.forEach(e => { %>
    <tr>
      <td><%= e.number %></td>
      <td><%= e.title || '-' %></td>
      <td>
        <form method="POST" action="/admin/episode/<%= e.id %>/delete" onsubmit="return confirm('Supprimer cet épisode ?')">
          <button class="link-danger">Supprimer</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
<%- include('partials/footer') %>
