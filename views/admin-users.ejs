<%- include('partials/header', { title: 'Membres' }) %>
<a href="/admin" class="muted">← Retour</a>
<h1>Membres (<%= users.length %>)</h1>

<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<form class="search" method="GET" action="/admin/users">
  <input type="text" name="q" placeholder="Rechercher par pseudo ou email..." value="<%= q %>">
  <button class="btn">Rechercher</button>
  <% if (q) { %><a class="btn gray" href="/admin/users">Effacer</a><% } %>
</form>

<div class="table-wrap">
<table class="table">
  <tr><th>Pseudo</th><th>Email</th><th>Rôle</th><th>Inscrit le</th><th>Dernière connexion</th><th>Actions</th></tr>
  <% users.forEach(u => { %>
    <tr class="<%= u.banned ? 'row-banned' : '' %>">
      <td><%= u.username %><% if (u.banned) { %> <span class="tag-ban">BANNI</span><% } %></td>
      <td><%= u.email || 'non renseigné' %></td>
      <td><%= u.role %></td>
      <td class="small"><%= u.created_at %></td>
      <td class="small"><%= u.last_login || '-' %></td>
      <td class="actions">
        <% if (u.role !== 'owner' && u.id !== user.id) { %>
          <% if (user.role === 'owner') { %>
            <form method="POST" action="/admin/users/<%= u.id %>/role">
              <input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>">
              <button class="btn small-btn"><%= u.role === 'admin' ? 'Retirer admin' : 'Promouvoir admin' %></button>
            </form>
          <% } %>
          <form method="POST" action="/admin/users/<%= u.id %>/ban" onsubmit="return confirm('<%= u.banned ? 'Débannir' : 'Bannir' %> ce membre ?')">
            <input type="hidden" name="banned" value="<%= u.banned ? '0' : '1' %>">
            <button class="btn small-btn <%= u.banned ? 'gray' : 'danger' %>"><%= u.banned ? 'Débannir' : 'Bannir' %></button>
          </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>
</div>
<%- include('partials/footer') %>
