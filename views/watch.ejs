<%- include('partials/header', { title: anime.title + ' - Ép. ' + episode.number }) %>

<a href="/anime/<%= anime.id %>" class="muted">← <%= anime.title %></a>
<h1>Épisode <%= episode.number %><%= episode.title ? ' - ' + episode.title : '' %></h1>

<video class="player" controls playsinline preload="metadata">
  <source src="/uploads/videos/<%= episode.video %>" type="video/mp4">
  Ton navigateur ne supporte pas la lecture vidéo.
</video>

<a class="btn" href="/download/<%= episode.id %>" download>⬇ Télécharger l'épisode</a>

<p class="muted small ios-tip" style="display:none">
  📱 iPhone : le fichier arrive dans l'app <strong>Fichiers</strong> (dossier Téléchargements).
  Pour l'avoir dans la Galerie : ouvre-le, appuie sur Partager, puis « Enregistrer la vidéo ».
</p>

<h2>Autres épisodes</h2>
<div class="episodes">
  <% episodes.forEach(e => { %>
    <a class="ep <%= e.id === episode.id ? 'active' : '' %>" href="/watch/<%= e.id %>">Ép. <%= e.number %></a>
  <% }) %>
</div>

<script>
  if (/iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
    document.querySelector('.ios-tip').style.display = 'block';
  }
</script>

<%- include('partials/footer') %>
